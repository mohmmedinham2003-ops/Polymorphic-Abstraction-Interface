import java.util.*;
//Without Polymorphism

class Splitter{
	public void split(int waterLevel){
	System.out.println(waterLevel>=50?"Alarm ON":"Alarm OFF");
	}

}

class Alarm{
	
	public void alarm(int waterLevel){
		System.out.println(waterLevel >=50?"Alarm ON":"Alarm OFF");
		}
	}

class Display{
	public void display(int waterLevel){
		System.out.println("WaterLevel : "+waterLevel);
	}
	
	}

class SMSSender{
	public void send(int waterLevel){
		System.out.println("Sending water level : "+waterLevel);
	}
}
